# 이 파일을 복사해 .env로 저장하고, 필요한 값만 채운다.
# .env는 절대 커밋하지 않는다 (.gitignore에 이미 포함).

# 학교·회사 네트워크에서 yfinance 접속 시 아래와 같은 오류가 나면 1로 설정한다.
#   "Cookie/crumb fetch failed (CertificateVerifyError)"
#   "$TICKER: possibly delisted; no price data found"
# yfinance가 기본으로 쓰는 curl_cffi(브라우저 TLS 지문 위장)가 학교·회사
# 네트워크의 TLS 검사(프록시)와 충돌할 때 이 값을 켜면 일반 requests로
# 우회한다. 일반 가정용 네트워크에서는 보통 필요 없다.
YF_DISABLE_CURL_CFFI=

# 텔레그램 일일 브리핑(P3)에서 쓰는 값. 비워 두면 발송하지 않고
# outputs/telegram_YYYY-MM-DD.txt에 저장만 한다.
# 1) 텔레그램 BotFather에서 봇을 만들고 토큰을 받는다.
# 2) 봇에게 메시지를 보낸 뒤 getUpdates로 chat_id를 확인한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 단체방(투자클럽) 공개 발송용. 비워 두면 단체방 발송만 건너뛴다(개인 발송은 그대로 됨).
# 일반 그룹은 '-'로 시작하는 음수 chat_id다. 그룹이 슈퍼그룹으로 전환되면 텔레그램이
# migrate_to_chat_id 오류로 새 id를 주는데, 그때는 개인 채팅으로 경고와 함께 새 id를 알려준다.
TELEGRAM_GROUP_CHAT_ID=
# FRED 공식 API 키 (없으면 키 없는 fredgraph.csv로 폴백 — GitHub 러너에서는 막히는 경우가 있다)
FRED_API_KEY=

# EODHD(eodhistoricaldata.com) 상장폐지 종목 조회용 (AI 펀드 F2, scripts/fund_check_eodhd_delisted.py).
# 무료 가입(신용카드 불필요, 일일 20회 호출)으로 발급받은 키를 넣는다. 스크립트 실행 전용 —
# 평소 live/paper 파이프라인은 이 키를 쓰지 않는다.
EODHD_API_KEY=
