# 이 파일을 복사해 .env로 저장하고, 필요한 값만 채운다.
# .env는 절대 커밋하지 않는다 (.gitignore에 이미 포함).

# 학교·회사 네트워크에서 yfinance 접속 시 아래와 같은 오류가 나면 1로 설정한다.
#   "Cookie/crumb fetch failed (CertificateVerifyError)"
#   "$TICKER: possibly delisted; no price data found"
# yfinance가 기본으로 쓰는 curl_cffi(브라우저 TLS 지문 위장)가 학교·회사
# 네트워크의 TLS 검사(프록시)와 충돌할 때 이 값을 켜면 일반 requests로
# 우회한다. 일반 가정용 네트워크에서는 보통 필요 없다.
YF_DISABLE_CURL_CFFI=

# 텔레그램 알림(P4 이후)에서 쓸 값. 아직 P1 범위에서는 쓰지 않는다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
