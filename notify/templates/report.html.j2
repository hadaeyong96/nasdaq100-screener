<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>나스닥 100 일일 브리핑 · {{ as_of_str }} ({{ mode_label }})</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<style>
:root{
  --paper:#f7f5f0; --card:#ffffff; --ink:#1d1f23; --sub:#5d6068; --line:#dcd8cf; --soft:#efece5; --grid:#e8e4db;
  --buy:#11734b; --buy-bg:#e5f3ec; --sell:#b3261e; --sell-bg:#fbe9e7;
  --warn:#9a6200; --warn-bg:#fdf3dc; --info:#1f4e8c; --info-bg:#e7eef8; --mute:#8a8d94; --tab:#e3dfd6;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#15171a; --card:#1d2024; --ink:#e9e7e2; --sub:#a4a7ae; --line:#34383e; --soft:#262a2f; --grid:#2c3035;
    --buy:#5cc995; --buy-bg:#16322a; --sell:#f08a80; --sell-bg:#3a1f1d;
    --warn:#e9b44c; --warn-bg:#3a2f16; --info:#8ab4f0; --info-bg:#1b2a40; --mute:#7c8087; --tab:#262a2f;
  }
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink)}
body{font-family:"Pretendard","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
  font-size:14px;line-height:1.5;font-variant-numeric:tabular-nums;
  padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
.wrap{max-width:1560px;margin:0 auto;padding:24px 16px 50px}
header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px;
  border-bottom:3px solid var(--ink);padding-bottom:12px;margin-bottom:16px}
h1{font-size:24px;font-weight:800;margin:0;letter-spacing:-0.02em}
.mode-badge{display:inline-block;margin-left:8px;padding:2px 10px;border-radius:999px;font-size:13px;font-weight:700;
  background:var(--info-bg);color:var(--info);vertical-align:middle}
.lead{color:var(--sub);font-size:13px;margin-top:4px}
.meta{color:var(--sub);font-size:13px;text-align:right}
.meta b{color:var(--ink)}
.fx-warn{color:var(--warn)}

/* ── 자금 계획 줄 (P3.6 6-3번) ───────────────────────────────── */
.plan{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin-bottom:16px}
.plan .items{display:flex;flex-wrap:wrap;gap:4px 18px;font-size:13px;color:var(--sub);margin-bottom:8px}
.plan .items b{color:var(--ink);font-size:14px}
.plan .items .qqqm b{color:var(--info)}
.bar{height:10px;border-radius:6px;overflow:hidden;display:flex;background:var(--grid)}
.bar span{height:100%}
.bar .b-held{background:var(--buy)}
.bar .b-reserved{background:#6fae8c}
.bar .b-new{background:var(--warn)}
.bar .b-remaining{background:var(--grid)}
.bar-legend{display:flex;flex-wrap:wrap;gap:10px 16px;font-size:11px;color:var(--mute);margin-top:6px}
.bar-legend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px;vertical-align:middle}

/* ── 규칙 탭 계산기 (P3.6 4번: 강조 배경 없음) ───────────────────── */
.calc-box{border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin-bottom:16px;font-size:13px;color:var(--sub)}
.calc-box .row{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin-bottom:6px}
.calc-box label{font-weight:700;color:var(--ink)}
.calc-box .in{display:inline-flex;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:6px;padding:0 8px}
.calc-box input{font:inherit;font-weight:700;width:130px;border:none;background:transparent;color:var(--ink);padding:4px 0;text-align:right;outline:none}
.calc-box .plan-out span{margin-right:10px;white-space:nowrap}
.calc-box .plan-out b{color:var(--ink)}
.calc-box .hint{font-size:12px;color:var(--mute)}
td.calc{color:var(--info);font-weight:700}
.pf{margin-bottom:8px}
.pf h2{font-size:15px;font-weight:700;margin:4px 0 6px;display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.pf h2 small{font-size:12px;font-weight:400;color:var(--mute)}
.pf table{min-width:820px}
.pf tfoot td{background:var(--soft);font-weight:700}
.todo{font-size:12px;color:var(--warn);background:var(--warn-bg);border-radius:6px;padding:5px 10px;margin:6px 0 8px}

/* 시트 탭 */
.tabs{display:flex;gap:2px;overflow-x:auto;border-bottom:2px solid var(--ink);scrollbar-width:thin}
.tabs button{font:inherit;font-size:13px;font-weight:600;color:var(--sub);background:var(--tab);border:1px solid var(--line);
  border-bottom:none;border-radius:8px 8px 0 0;padding:8px 14px;cursor:pointer;white-space:nowrap}
.tabs button .n{display:inline-block;min-width:18px;margin-left:6px;padding:0 5px;border-radius:9px;background:var(--card);font-size:11px;color:var(--sub)}
.tabs button[aria-selected="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.tabs button[aria-selected="true"] .n{background:var(--paper);color:var(--ink)}
.subtabs{display:flex;gap:6px;flex-wrap:wrap;margin:12px 0 8px}
.subtabs button{font:inherit;font-size:13px;border:1px solid var(--line);background:var(--card);color:var(--sub);
  border-radius:999px;padding:5px 12px;cursor:pointer}
.subtabs button.has{border-color:var(--buy)}
.subtabs button.empty{opacity:.55}
.subtabs button[aria-selected="true"]{background:var(--buy);border-color:var(--buy);color:#fff}
.panel{display:none;padding-top:12px}.panel.on{display:block}
.sub{display:none}.sub.on{display:block}
.desc{color:var(--sub);font-size:13px;margin:0 0 10px}
.risk-line{font-weight:700;color:var(--ink)}

/* 시트 표 */
.sheet{overflow-x:auto;background:var(--card);border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%;min-width:760px}
th,td{padding:7px 10px;border:1px solid var(--grid);text-align:left;white-space:nowrap;vertical-align:middle}
th{background:var(--soft);font-size:12px;color:var(--sub);font-weight:600;position:sticky;top:0;cursor:pointer;user-select:none}
th::after{content:" ↕";color:var(--mute);font-size:10px}
th.asc::after{content:" ▲";color:var(--ink)}th.desc::after{content:" ▼";color:var(--ink)}
th.nosort{cursor:default}th.nosort::after{content:""}
td.num,th.num{text-align:right}
td.note{white-space:normal;min-width:200px;color:var(--sub)}
.tk{font-weight:700}
.nm{font-weight:700}
a.tk{font-weight:600;color:var(--ink);text-decoration:none;border-bottom:1px dashed var(--mute)}
a.tk:hover{color:var(--info);border-bottom-color:var(--info)}
a.tk::after{content:" ↗";font-size:11px;color:var(--mute);font-weight:400}
.kr{color:var(--sub);font-size:12px;margin-left:4px}
.ok{color:var(--buy);font-weight:700}.no{color:var(--sell);font-weight:700}.na{color:var(--mute)}
.badge{display:inline-block;border-radius:999px;padding:1px 8px;font-size:12px;font-weight:600}
.b-buy{background:var(--buy-bg);color:var(--buy)}.b-sell{background:var(--sell-bg);color:var(--sell)}
.b-warn{background:var(--warn-bg);color:var(--warn)}.b-info{background:var(--info-bg);color:var(--info)}
.stage{display:inline-flex;gap:3px}
.stage span{width:22px;height:18px;border-radius:4px;font-size:11px;display:inline-flex;align-items:center;justify-content:center;background:var(--soft);color:var(--mute)}
.stage span.on{background:var(--buy);color:#fff}
.empty{padding:18px;color:var(--mute);text-align:center}
.cnt{font-weight:800;font-size:15px}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:12px}
.two table{min-width:0}
/* 선별 이유 (쉬운 설명, P3.7) */
.whybtn{font:inherit;font-size:12px;font-weight:700;color:var(--info);background:var(--info-bg);border:1px solid transparent;border-radius:999px;padding:2px 10px;cursor:pointer;white-space:nowrap}
.whybtn:hover{border-color:var(--info)}
.whybtn[aria-expanded="true"]{background:var(--info);color:#fff}
.whybtn:disabled{opacity:.4;cursor:default}
tr.why{display:none}
tr.why.open{display:table-row}
tr.why td{background:var(--soft);white-space:normal;padding:10px 14px}
.whybox{max-width:980px;font-size:13px;line-height:1.65}
.whybox .wt{font-weight:800;font-size:14px;margin-bottom:6px}
.whybox .wt .badge{margin-left:6px;vertical-align:1px}
.chk{list-style:none;margin:0 0 8px;padding:0;display:flex;flex-wrap:wrap;gap:6px}
.chk li{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:3px 9px;font-size:12px}
.chk li.y::before{content:"✔ ";color:var(--buy);font-weight:800}
.chk li.n::before{content:"✘ ";color:var(--sell);font-weight:800}
.chk li.i::before{content:"• ";color:var(--mute);font-weight:800}
.whybox p{margin:0 0 6px}
.whybox .nx{color:var(--sub)}
.whybox .nx b{color:var(--ink)}
.guidebar{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;font-size:13px;color:var(--sub);margin:0 0 10px}
.guidebar button{font:inherit;font-size:12px;border:1px solid var(--line);background:var(--card);color:var(--sub);border-radius:999px;padding:3px 11px;cursor:pointer}
.guidebar a{color:var(--info);font-weight:700;cursor:pointer;text-decoration:none}

/* 읽는 법 탭 */
.gd h2{font-size:17px;font-weight:800;margin:22px 0 8px;letter-spacing:-0.01em}
.gd h2:first-child{margin-top:4px}
.gd .lead2{color:var(--sub);font-size:13px;margin:0 0 10px}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;counter-reset:st}
.steps div{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:13px;color:var(--sub)}
.steps div b{display:block;color:var(--ink);font-size:14px;margin-bottom:2px}
.steps div b::before{counter-increment:st;content:counter(st);display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:var(--ink);color:var(--paper);font-size:12px;margin-right:6px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-size:13px}
.card h3{font-size:15px;margin:0 0 2px;font-weight:800}
.card .en{color:var(--mute);font-size:12px;margin-bottom:8px}
.card dl{margin:0;display:grid;grid-template-columns:72px 1fr;gap:5px 10px}
.card dt{color:var(--sub);font-weight:600}
.card dd{margin:0}
.flow{display:flex;flex-wrap:wrap;align-items:stretch;gap:6px}
.flow .fs{flex:1 1 170px;background:var(--card);border:1px solid var(--line);border-top:4px solid var(--buy);border-radius:8px;padding:9px 11px;font-size:13px}
.flow.out .fs{border-top-color:var(--sell)}
.flow .fs b{display:block;font-size:14px}
.flow .fs small{display:block;color:var(--mute);font-size:12px;margin-bottom:4px}
.flow .ar{align-self:center;color:var(--mute);font-weight:800}
.gd .sheet table{min-width:0}
.gd td{white-space:normal}
footer{margin-top:28px;color:var(--mute);font-size:12px;border-top:1px solid var(--line);padding-top:10px}
.stale-banner{background:var(--sell);color:#fff;font-weight:700;font-size:14px;
  border-radius:8px;padding:10px 14px;margin-bottom:16px}

/* ── 휴대폰 화면: 표를 카드로 ───────────────── */
.tabs{position:sticky;top:0;z-index:5;background:var(--paper);padding-top:env(safe-area-inset-top,0)}
@media (max-width:640px){
  body{font-size:15px}
  .wrap{padding:14px 12px 40px}
  header{flex-direction:column;align-items:flex-start;gap:6px}
  h1{font-size:21px}
  .meta{text-align:left}
  .plan .items{flex-direction:column;gap:2px}
  .calc-box .row{flex-direction:column;align-items:flex-start}
  .tabs button{padding:9px 12px;font-size:14px}
  .subtabs button{font-size:14px;padding:7px 12px}
  .sheet{background:transparent;border:none;overflow:visible}
  .sheet table,.pf table{min-width:0}
  .sheet table,.sheet tbody,.sheet tfoot{display:block;width:100%}
  .sheet thead{display:none}
  .sheet tr{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:10px;
    display:grid;grid-template-columns:1fr 1fr 1fr;column-gap:10px;row-gap:8px}
  .sheet td{border:none;padding:0;white-space:normal;text-align:left;min-width:0}
  .sheet td::before{content:attr(data-label);display:block;color:var(--sub);font-size:11px;line-height:1.3;margin-bottom:1px}
  .sheet td.num{text-align:left}
  .sheet td:first-child{grid-column:1/-1;font-size:17px;padding-bottom:8px;border-bottom:1px solid var(--grid)}
  .sheet td:first-child::before{content:none}
  .sheet td:nth-child(2){grid-column:1/-1;margin-top:-6px;padding-bottom:6px}
  .sheet td.note{grid-column:1/-1;color:var(--sub);font-size:13px}
  .sheet td.note:empty{display:none}
  .sheet td.empty{grid-column:1/-1;text-align:center}
  .sheet td.empty::before{content:none}
  .sheet tr:has(td.empty){display:block}
  .sheet td.calc{color:var(--info);font-weight:700}
  .sheet tfoot tr{background:var(--soft)}
  .sheet tfoot td:empty{display:none}
  .two{grid-template-columns:1fr}
  .sheet tr.why{display:none;padding:0;border:none;background:transparent;margin:-6px 0 10px}
  .sheet tr.why.open{display:block}
  .sheet tr.why td{display:block;grid-column:auto;font-size:14px;padding:10px 12px;border:1px solid var(--line);border-radius:12px}
  .sheet tr.why td::before{content:none}
}
</style>
</head>
<body data-fx="{{ data_fx }}" data-date="{{ as_of_str }}" data-total="{{ total_krw }}" data-limit-pct="{{ strategy_limit_pct }}" data-used="{{ data_used }}" data-reserved="{{ data_reserved }}" data-slot="{{ data_slot }}">
<div class="wrap">

{% macro finviz(ticker) -%}
<a class="tk" href="https://finviz.com/quote.ashx?t={{ ticker }}&p=d" target="_blank" rel="noopener" title="{{ ticker }} 차트 (Finviz)">{{ ticker }}</a>
{%- endmacro %}

{% macro explain_cell(explain) -%}
<td class="nosort"><button type="button" class="whybtn" aria-expanded="false"{% if not explain %} disabled{% endif %}>왜?</button></td>
{%- endmacro %}

{% macro why_row(explain, colspan) -%}
{% if explain %}
<tr class="why"><td colspan="{{ colspan }}"><div class="whybox">
  <div class="wt">{{ explain.title }}{% if explain.badge %}<span class="badge b-info">{{ explain.badge }}</span>{% endif %}</div>
  {% if explain.checks %}<ul class="chk">{% for c in explain.checks %}<li class="{{ c.level }}">{{ c.text }}</li>{% endfor %}</ul>{% endif %}
  {% if explain.body %}<p>{{ explain.body|safe }}</p>{% endif %}
  {% if explain.next %}<p class="nx"><b>다음 단계</b> · {{ explain.next }}</p>{% endif %}
</div></td></tr>
{% endif %}
{%- endmacro %}

{% if stale %}
<div class="stale-banner">
  데이터 지연: 기대 기준일 {{ expected_date_str }}, 실제 {{ actual_date_str }}. 오늘은 매매 신호 없음
</div>
{% endif %}

<header>
  <div>
    <h1>나스닥 100 일일 브리핑<span class="mode-badge">{{ mode_label }}</span></h1>
    <div class="lead">MACD 중심 1:2:6 분할 전략 · 미국 종가 확정 기준</div>
  </div>
  <div class="meta">
    기준일 <b>{{ as_of_str }} 종가</b><br>
    주문 가능일 <b>{{ order_date_str }}</b><br>
    총자금 <b>{{ total_krw_str }} 원</b> · 환율 <b>₩{{ fx_rate_str }}/$</b>{% if fx_date_str %} ({{ fx_date_str }}){% endif %}{% if fx_is_fallback %} <span class="fx-warn">캐시값</span>{% endif %} · 생성 {{ generated_str }}
  </div>
</header>

{% if funding %}
<div class="plan">
  <div class="items">
    <span>전략 한도 <b>{{ strategy_limit_str }}</b> ({{ strategy_limit_pct }}%)</span>
    <span>종목당 슬롯 <b>{{ slot_str }}</b></span>
    <span>보유 <b>{{ held_str }}</b></span>
    <span>2·3차 예약 <b>{{ reserved_str }}</b></span>
    <span>오늘 신규 <b>{{ new_str }}</b></span>
    <span>남은 한도 <b>{{ remaining_str }}</b></span>
    <span class="qqqm">QQQM 목표 <b>{{ qqqm_str }}</b></span>
  </div>
  <div class="bar">
    <span class="b-held" style="width:{{ '%.2f'|format(held_pct) }}%"></span>
    <span class="b-reserved" style="width:{{ '%.2f'|format(reserved_pct) }}%"></span>
    <span class="b-new" style="width:{{ '%.2f'|format(new_pct) }}%"></span>
    <span class="b-remaining" style="width:{{ '%.2f'|format(remaining_pct) }}%"></span>
  </div>
  <div class="bar-legend">
    <span><i style="background:var(--buy)"></i>보유</span>
    <span><i style="background:#6fae8c"></i>2·3차 예약</span>
    <span><i style="background:var(--warn)"></i>오늘 신규</span>
    <span><i style="background:var(--grid)"></i>남은 한도</span>
  </div>
</div>
{% endif %}

<nav class="tabs" role="tablist">
  <button role="tab" data-tab="buy" aria-selected="true">신규 매수<span class="n">{{ buy_count }}</span></button>
  <button role="tab" data-tab="sell" aria-selected="false">매도·손절<span class="n">{{ sell_count }}</span></button>
  <button role="tab" data-tab="hold" aria-selected="false">보유 현황<span class="n">{{ held_count }}/{{ max_concurrent }}</span></button>
  <button role="tab" data-tab="watch" aria-selected="false">관찰 목록<span class="n">{{ watch_count }}</span></button>
  <button role="tab" data-tab="filtered" aria-selected="false">걸러진 신호<span class="n">{{ filtered_count }}</span></button>
  <button role="tab" data-tab="warn" aria-selected="false">경고<span class="n">{{ warn_count }}</span></button>
  <button role="tab" data-tab="rules" aria-selected="false">규칙</button>
  <button role="tab" data-tab="guide" aria-selected="false">읽는 법</button>
</nav>
<div class="guidebar" style="margin-top:10px">
  <span>각 줄 끝의 <span class="whybtn" style="cursor:default">왜?</span>를 누르면 그 종목이 <b>어떤 지표 때문에</b> 선별됐는지 쉬운 말로 보여 줍니다.</span>
  <button type="button" id="whyAll" aria-pressed="false">모든 설명 펼치기</button>
  <a data-goto="guide">처음이라면 → 읽는 법</a>
</div>

<!-- 신규 매수 -->
<section class="panel on" id="buy">
  <p class="desc"><span class="risk-line">오늘 신규 위험 {{ buy_risk_sum_str }} (계좌의 {{ buy_risk_pct }}%)</span> · 다음 거래일에 지정가(종가 × 1.01) 이하로 주문하고, 체결되지 않으면 취소합니다. 체결 후 손절 예약 주문을 바로 겁니다.</p>
  <div class="subtabs" role="tablist">
  {% for tab in buy_tabs %}
    <button data-sub="{{ tab.key }}" aria-selected="{{ 'true' if loop.first else 'false' }}" class="{{ 'has' if tab.count else 'empty' }}">{{ tab.title }} ({{ tab.count }})</button>
  {% endfor %}
  </div>

  {% for tab in buy_tabs %}
  <div class="sub{{ ' on' if loop.first else '' }}" id="{{ tab.key }}"><div class="sheet"><table>
  <thead><tr>
    <th class="nosort">종목</th><th class="nosort">티커</th>
    {% if tab.key == 'all' %}<th class="nosort">차수</th>{% endif %}
    <th class="nosort">결정</th><th class="num">지정가</th><th class="num">수량</th><th class="num">투입금액</th>
    <th class="num">손절가</th><th class="num">손절폭</th>
    {% if tab.key != 'all' %}<th class="num">최대손실</th>{% endif %}
    <th class="num">점수</th><th class="nosort">비고</th><th class="nosort">설명</th>
  </tr></thead>
  <tbody>
  {% if not tab.rows %}
  <tr><td colspan="{{ tab.headers|length }}" class="empty">오늘 해당 종목 없음</td></tr>
  {% else %}
  {% for row in tab.rows %}
  <tr class="sig" data-key="{{ row.key }}" data-stage="{{ row.stage }}" data-new="{{ '1' if row.is_new_position else '0' }}" data-score="{{ row.score }}" data-limit="{{ row.limit }}" data-stop="{{ row.stop if row.stop is not none else '' }}">
    <td class="nm">{{ row.kr }}</td>
    <td>{{ finviz(row.ticker) }}</td>
    {% if tab.key == 'all' %}<td>{{ row.stage_label }}</td>{% endif %}
    <td><span class="badge {{ 'b-buy' if row.decision == '매수' else 'b-warn' }}">{{ row.decision }}</span></td>
    <td class="num" data-v="{{ row.limit }}">${{ '%.2f'|format(row.limit) }}</td>
    <td class="num calc q">{{ row.qty }}</td>
    <td class="num calc amt" data-v="{{ row.amount_krw }}">{{ row.amount_krw_str }}</td>
    <td class="num">{{ '$%.2f'|format(row.stop) if row.stop is not none else '미확정' }}</td>
    <td class="num">{{ '%+.1f%%'|format(row.stop_pct) if row.stop_pct is not none else '-' }}</td>
    {% if tab.key != 'all' %}<td class="num calc ml">{{ row.max_loss_krw_str }}</td>{% endif %}
    <td class="num">{{ row.score }}</td>
    <td class="note">{{ row.note }}</td>
    {{ explain_cell(row.explain) }}
  </tr>
  {{ why_row(row.explain, tab.headers|length) }}
  {% endfor %}
  {% endif %}
  </tbody></table></div></div>
  {% endfor %}
</section>

<!-- 매도·손절 -->
