    <td class="num {{ 'ok' if hold_totals.pnl_pct is not none and hold_totals.pnl_pct >= 0 else 'no' }}">{{ '%+.1f%%'|format(hold_totals.pnl_pct) if hold_totals.pnl_pct is not none else '-' }}</td>
    <td></td><td></td><td></td>
  </tr></tfoot>
  {% endif %}
  </table></div>
</section>

<!-- 관찰 목록 -->
