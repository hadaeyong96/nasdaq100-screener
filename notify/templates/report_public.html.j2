<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ titles.title }} ({{ titles.public_suffix }}) · {{ as_of_str }}</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<style>
:root{
  --paper:#f7f5f0; --card:#ffffff; --ink:#1d1f23; --sub:#5d6068; --line:#dcd8cf; --soft:#efece5; --grid:#e8e4db;
  --buy:#11734b; --buy-bg:#e5f3ec; --sell:#b3261e; --sell-bg:#fbe9e7;
  --warn:#9a6200; --warn-bg:#fdf3dc; --info:#1f4e8c; --info-bg:#e7eef8; --mute:#8a8d94; --tab:#e3dfd6;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#15171a; --card:#1d2024; --ink:#e9e7e2; --sub:#a4a7ae; --line:#34383e; --soft:#262a2f; --grid:#2c3035;
    --buy:#5cc995; --buy-bg:#16322a; --sell:#f08a80; --sell-bg:#3a1f1d;
    --warn:#e9b44c; --warn-bg:#3a2f16; --info:#8ab4f0; --info-bg:#1b2a40; --mute:#7c8087; --tab:#262a2f;
  }
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink)}
body{font-family:"Pretendard","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
  font-size:14px;line-height:1.5;font-variant-numeric:tabular-nums;
  padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
.wrap{max-width:1560px;margin:0 auto;padding:24px 16px 50px}
header{border-bottom:3px solid var(--ink);padding-bottom:12px;margin-bottom:16px}
h1{font-size:22px;font-weight:800;margin:0;letter-spacing:-0.02em}
h1 .suffix{font-weight:400;color:var(--sub);font-size:14px}
.subtitle{color:var(--ink);font-size:14px;font-weight:600;margin-top:4px}
.lead{color:var(--sub);font-size:13px;margin-top:4px}
h2.sec{font-size:16px;font-weight:800;margin:20px 0 8px}

/* 시장 온도 (report.html.j2와 동일한 카드 스타일) */
.macro{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px 12px;margin-bottom:12px}
.mhead{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;font-size:12px;color:var(--sub);margin-bottom:8px}
.mhead>b{font-size:15px;color:var(--ink)}
.mhead a{margin-left:auto;color:var(--info);font-weight:700;cursor:pointer}
.mgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.mt{border:1px solid var(--grid);border-radius:8px;padding:8px 10px;min-width:0}
.mn{display:block;font-size:12px;color:var(--sub);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-decoration:none}
.mn .q{color:var(--info);font-weight:700}
.mn small{display:block;font-weight:400;color:var(--mute);font-size:11px}
.mv{display:flex;align-items:baseline;gap:3px;margin:2px 0}
.mv b{font-size:22px;font-weight:800;letter-spacing:-0.02em;color:var(--ink)}
.mv .u{font-size:12px;color:var(--sub)}
.mv .mc{margin-left:auto;font-size:12px;color:var(--sub)}
.spark{display:block;width:100%;height:30px;margin:2px 0 4px}
.spark polyline{fill:none;stroke:var(--sub);stroke-width:1.6;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke}
.spark circle{fill:var(--ink);stroke:var(--card);stroke-width:1.5}
.spark .ref{stroke:var(--mute);stroke-width:1;stroke-dasharray:3 3;vector-effect:non-scaling-stroke}
.mf{display:flex;flex-direction:column;gap:2px}
.mr{font-size:11px;color:var(--mute);line-height:1.35}
.mbody{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:8px;align-items:center}
.mchart{display:block;color:inherit;text-decoration:none;min-width:0}
.mchart small{display:block;font-size:10px;color:var(--info);text-align:right}
.mscale{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px;font-size:11px;color:var(--sub)}
.mscale li{display:grid;grid-template-columns:auto 1fr auto;gap:4px;align-items:baseline;border-radius:5px;padding:1px 4px}
.mscale li b{font-weight:700;white-space:nowrap}
.mscale li .rg{color:var(--mute);line-height:1.3}
.mscale li.cur{background:var(--tab);color:var(--ink);font-weight:700}
.mscale li.cur .rg{color:var(--ink)}
.mscale .star{color:var(--warn);font-weight:800}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;vertical-align:middle;margin:0 3px 1px 0;flex:none}
.dot-ok{background:var(--buy)}.dot-warn{background:var(--warn)}.dot-bad{background:var(--sell)}
@media (max-width:1100px){.mgrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:640px){.mgrid{grid-template-columns:minmax(0,1fr)}.mhead a{margin-left:0}.mbody{grid-template-columns:minmax(0,1fr)}}

/* 오늘의 추천 표 */
.sheet{overflow-x:auto;background:var(--card);border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%;min-width:560px}
th,td{padding:7px 10px;border:1px solid var(--grid);text-align:left;vertical-align:middle}
th{background:var(--soft);font-size:12px;color:var(--sub);font-weight:600}
td.num,th.num{text-align:right;white-space:nowrap}
td.note{white-space:normal;min-width:180px;color:var(--sub)}
.tk{font-weight:700;white-space:nowrap}
a.tk{color:inherit;text-decoration:none;border-bottom:1px dotted var(--mute)}
a.tk:hover{border-bottom-style:solid}
.kr{color:var(--sub);font-size:12px;margin-left:4px}
.badge{display:inline-block;border-radius:999px;padding:1px 8px;font-size:12px;font-weight:600;white-space:nowrap}
.b-buy{background:var(--buy-bg);color:var(--buy)}.b-warn{background:var(--warn-bg);color:var(--warn)}
.empty{padding:18px;color:var(--mute);text-align:center}
@media (max-width:640px){
  .wrap{padding:14px 12px 40px}
  h1{font-size:19px}
  .sheet{background:transparent;border:none;overflow:visible}
  table{min-width:0}
  table,tbody{display:block;width:100%}
  thead{display:none}
  /* 카드 한 장 = 한 종목. tr만 block으로 바꾸고 td를 table-cell로 두면 칸들이 익명 표 한 줄에
     옆으로 끼여 좁아지고(종목명·배지가 한 글자씩 줄바꿈), 조건 칸 min-width 때문에 카드 밖으로
     넘친다 — 그래서 tr을 2열 grid로 만들어 td를 grid 칸(=block)으로 쓴다. */
  tr{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:10px;
    display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:12px;row-gap:6px}
  td{border:none;padding:0;white-space:normal;text-align:left;min-width:0}
  td::before{content:attr(data-label);display:block;color:var(--sub);font-size:11px;line-height:1.3;margin-bottom:1px}
  td.num{text-align:left}
  td:first-child{grid-column:1/-1;font-size:16px;padding-bottom:6px;border-bottom:1px solid var(--grid)}
  td:first-child::before{content:none}
  td:nth-child(2){grid-column:1/-1}
  td:nth-child(2)::before{content:none}
  td.note{grid-column:1/-1;min-width:0;font-size:13px}
  td.note:empty{display:none}
  td.empty{grid-column:1/-1;text-align:center}
  td.empty::before{content:none}
}

/* 지표 설명 (초보자용, macro_explain 그대로) */
.mexp{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-top:16px}
.mexp>h2{margin:0 0 4px;font-size:17px}
.mexp article{border-top:1px solid var(--grid);padding:12px 0 6px;scroll-margin-top:64px}
.mexp h3{margin:0 0 6px;font-size:15px}
.mexp p{margin:4px 0;font-size:14px;line-height:1.6}
.mexp p b{display:block;color:var(--sub);font-size:13px;margin-bottom:1px}
.mexp .now{background:var(--tab);border-radius:6px;padding:6px 8px}
.mexp .back{font-size:13px;color:var(--info);font-weight:700;text-decoration:none}
.mexp .disc{margin-top:10px;font-size:13px;color:var(--sub);font-weight:700}
.mt{scroll-margin-top:16px}

footer{margin-top:28px;color:var(--mute);font-size:12px;border-top:1px solid var(--line);padding-top:10px;font-weight:700}
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>{{ titles.title }} <span class="suffix">({{ titles.public_suffix }})</span></h1>
  <div class="subtitle">{{ titles.subtitle }}</div>
  <div class="lead">MACD 중심 1:2:6 분할 전략 · 미국 종가 확정 기준 · 기준일 {{ as_of_str }} · 생성 {{ generated_str }}</div>
</header>

{% if macro_rows %}
<section class="macro" aria-label="시장 온도">
  <div class="mhead"><b>시장 온도</b><span>CNN 공포·탐욕 지수 + FRED 장기 지표 · 기준일 {{ macro_as_of_str }} · <i class="dot dot-ok" aria-hidden="true"></i>안정 · <i class="dot dot-warn" aria-hidden="true"></i>주의 · <i class="dot dot-bad" aria-hidden="true"></i>위험, ★ = 오늘 위치 · <b>참고용이며 매매 규칙에는 쓰지 않습니다</b></span><a href="#macro-explain">지표 설명 ↓</a></div>
  <div class="mgrid">
  {% for m in macro_rows %}
    <div class="mt" id="macro-{{ m.slug }}" title="{{ m.name }}{% if m.code %} · {{ m.code }}{% endif %}{% if m.range_str != '-' %} · 1년 {{ m.range_str }}{% endif %}">
      <a class="mn" href="#explain-{{ m.slug }}">{{ m.name }} <span class="q">ⓘ</span><small>{{ m.code }}</small></a>
      <div class="mv"><b>{{ m.value_str }}</b>{% if m.unit %}<span class="u">{{ m.unit }}</span>{% endif %}{% if m.change_str %}<span class="mc">1주 {{ m.change_str }}</span>{% endif %}</div>
      <div class="mbody">
        <a class="mchart" href="#explain-{{ m.slug }}" aria-label="{{ m.name }} 설명 보기">
        {% if m.spark_points %}
        <svg class="spark" viewBox="0 0 150 34" preserveAspectRatio="none" aria-hidden="true">
          {% for y in m.ref_ys %}<line x1="2" x2="148" y1="{{ y }}" y2="{{ y }}" class="ref"/>{% endfor %}
          <polyline points="{{ m.spark_points }}"/>
          {% set last = m.spark_points.split(' ')[-1].split(',') %}
          <circle cx="{{ last[0] }}" cy="{{ last[1] }}" r="2.5"/>
        </svg>
        {% endif %}
        <small>1년 그래프 · 설명 보기 ↓</small></a>
        <ol class="mscale" aria-label="{{ m.name }} 판정 기준">
          {% for sc in m.scale %}<li class="{{ 'cur' if sc.current else '' }}"><b><i class="dot dot-{{ sc.status }}" aria-hidden="true"></i>{{ sc.label }}</b><span class="rg">{{ sc.range }}</span><span class="star">{{ '★' if sc.current else '' }}</span></li>{% endfor %}
        </ol>
      </div>
      {% set notes = [] %}{% if m.is_stale %}{% set _ = notes.append('지연(' ~ m.as_of ~ ')') %}{% endif %}{% if m.short_range %}{% set _ = notes.append('기간 짧음') %}{% endif %}{% if m.note %}{% set _ = notes.append(m.note) %}{% endif %}
      {% if notes %}<div class="mf"><span class="mr">{{ notes | join(' · ') }}</span></div>{% endif %}
    </div>
  {% endfor %}
  </div>
</section>
{% endif %}

<h2 class="sec">오늘의 추천 ({{ buy_count }}건)</h2>
<div class="sheet">
<table>
<thead><tr><th>종목</th><th>단계</th><th class="num">진입가</th><th class="num">손절가</th><th>조건</th></tr></thead>
<tbody>
{% if buy_rows %}
{% for r in buy_rows %}
<tr>
  <td data-label="종목"><a class="tk" href="https://finviz.com/quote.ashx?t={{ r.ticker }}" target="_blank" rel="noopener" title="{{ r.ticker }} (Finviz)">{{ r.ticker }}</a><span class="kr">{{ r.kr }}</span></td>
  <td data-label="단계"><span class="badge {{ 'b-buy' if r.decision == '매수' else 'b-warn' }}">{{ r.stage_label }}</span></td>
  <td data-label="진입가" class="num">{{ '${:,.2f}'.format(r.limit) if r.limit is not none else '-' }}</td>
  <td data-label="손절가" class="num">{% if r.stop is not none %}{{ '${:,.2f}'.format(r.stop) }}{% if r.stop_pct is not none %} ({{ r.stop_pct }}%){% endif %}{% else %}미확인{% endif %}</td>
  <td data-label="조건" class="note">{{ r.condition }}</td>
</tr>
{% endfor %}
{% else %}
<tr><td colspan="5" class="empty">오늘 추천 종목 없음</td></tr>
{% endif %}
</tbody>
</table>
</div>

{% if macro_rows %}
<section class="mexp" id="macro-explain" aria-label="시장 온도 지표 설명">
  <h2>시장 온도 지표 설명 (처음 보는 분용)</h2>
  {% for m in macro_rows %}
  <article id="explain-{{ m.slug }}">
    <h3>{{ m.explain.title }} — 오늘 {{ m.value_str }}{% if m.unit and m.unit != '/100' %}{{ m.unit }}{% endif %} {{ m.badge.text }}</h3>
    <p><b>① 이게 뭔가요</b>{{ m.explain.what }}</p>
    <p><b>② 주식시장에 왜 영향을 주나요</b>{{ m.explain.why }}</p>
    <p><b>③ 실제 예시</b>{{ m.explain.example }}</p>
    <p class="now"><b>④ 지금 수치는 어떻게 읽나요</b>{{ m.explain.now }}</p>
    <a class="back" href="#macro-{{ m.slug }}">↑ 그래프로 돌아가기</a>
  </article>
  {% endfor %}
  <p class="disc">{{ macro_disclaimer }}</p>
</section>
{% endif %}

<footer>{{ public_disclaimer }}</footer>
</div>
</body>
</html>
