      "Bash(cat ./.env*)",
      "Bash(type .env)",
      "Bash(type .env*)",
      "Bash(type ./.env)",
      "Bash(type ./.env*)",
      "Bash(more .env)",
      "Bash(more .env*)",
      "Bash(more ./.env)",
      "Bash(more ./.env*)",
      "Bash(less .env)",
      "Bash(less .env*)",
      "Bash(less ./.env)",
      "Bash(less ./.env*)",
      "Bash(head .env)",
      "Bash(head .env*)",
      "Bash(head ./.env)",
      "Bash(head ./.env*)",
      "Bash(tail .env)",
      "Bash(tail .env*)",
      "Bash(tail ./.env)",
      "Bash(tail ./.env*)",
      "Bash(cat -A .env*)",
      "Bash(cat -A ./.env*)",
      "Bash(strings .env*)",
      "Bash(strings ./.env*)",
